# ==============================================================================
# ReStockIQ — Environment Configuration Example
# Predict Shortages. Prevent Stockouts.
# ==============================================================================
# Copy this file to .env for local development.
# Configure real production values in Vercel Environment Variables.
# All values below are placeholders. Never commit actual secrets to GitHub.

# ==============================================================================
# 1. Firebase Authentication & Firestore — Frontend Configuration
# ==============================================================================

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your_firestore_database_id

# ==============================================================================
# 2. Supabase — Frontend Public Configuration
# Use only an anon or publishable key in frontend variables.
# ==============================================================================

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Optional alternative if supported by your application:
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ==============================================================================
# 3. Server-Only Configuration & Secrets
# Never prefix these variables with VITE_ or NEXT_PUBLIC_.
# ==============================================================================

SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_service_role_or_secret_key

# Optional: required only if server-side Gemini features are enabled
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# 4. Google Apps Script — Email Automation
# ==============================================================================

STOCKPILOT_APPS_SCRIPT_URL=your_google_apps_script_deployment_exec_url
STOCKPILOT_APPS_SCRIPT_SECRET=your_shared_apps_script_webhook_secret

# ==============================================================================
# 5. Application URL
# ==============================================================================

STOCKPILOT_APP_URL=your_production_application_url
