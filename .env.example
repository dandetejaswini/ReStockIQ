# ==============================================================================
# ReStockIQ — Production & Development Environment Configuration Example
# AI-Powered Inventory Intelligence & Supply-Chain Optimization
# Tagline: Predict Shortages. Prevent Stockouts.
# ==============================================================================
# Copy this file to `.env` (local) or configure these variables in Vercel
# Project Settings > Environment Variables.
# NEVER commit real secret values to `.env.example` or Git!

# ==============================================================================
# 1. Frontend Public Variables — Firebase Authentication & Firestore
#    (Safe for Browser Bundle — Supports both VITE_* and NEXT_PUBLIC_* prefixes)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=stockpilotai-2dcae.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stockpilotai-2dcae
VITE_FIREBASE_STORAGE_BUCKET=stockpilotai-2dcae.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1025122764341
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here
VITE_FIREBASE_FIRESTORE_DATABASE_ID=your_firestore_database_id_or_default

# Optional Next.js-style aliases (also supported by vite.config.ts):
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=stockpilotai-2dcae.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stockpilotai-2dcae
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=stockpilotai-2dcae.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1025122764341
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id_here
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=your_firestore_database_id_or_default

# ==============================================================================
# 2. Frontend Public Variables — Supabase PostgreSQL Client
#    (Safe for Browser Bundle — Use ONLY public anon or sb_publishable_* keys)
# ==============================================================================
VITE_SUPABASE_URL=https://tewaaznazgsmaherddeu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# Optional Next.js-style aliases (also supported by vite.config.ts):
NEXT_PUBLIC_SUPABASE_URL=https://tewaaznazgsmaherddeu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_here

# ==============================================================================
# 3. Server-Only Secrets (NEVER prefix with VITE_ or NEXT_PUBLIC_)
#    Used exclusively by Express / Vercel Serverless API routes (/api/*)
# ==============================================================================
# Supabase Service-Role / Secret Key (Required for server-side tenant queries & RPCs)
SUPABASE_SECRET_KEY=your_supabase_service_role_or_secret_key_here

# Optional Gemini API Key (Server-side AI analysis if enabled)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Apps Script Email Automation Webhook & Canonical App URL
STOCKPILOT_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
STOCKPILOT_APPS_SCRIPT_SECRET=your_shared_apps_script_webhook_secret_here
STOCKPILOT_APP_URL=https://your-production-domain.vercel.app
